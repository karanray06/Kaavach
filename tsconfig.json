{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./web/dist",
    "rootDir": "./web/ts",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["web/ts/reveal.ts", "web/ts/scan.ts", "web/ts/radar.ts", "web/ts/drill.ts"],
  "exclude": ["node_modules"]
}
